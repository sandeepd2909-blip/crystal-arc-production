# ──────────────────────────────────────────────────────────────────────────
# Both locales are prefixed: English /en/*, Arabic /ar/*. Nothing is served
# from a bare path, so every rule below is load-bearing — `output: "export"`
# means there is no server and these are the only request-time logic the site
# has. Netlify evaluates in file order and stops at the first match.
# ──────────────────────────────────────────────────────────────────────────

# ── The root ──
# Arabic first: more specific, and order decides.
#
# 302, not 301: the target depends on a request header, so it must not be
# cached as a permanent property of the URL. Netlify matches Language= against
# Accept-Language, and any `ar-*` variant counts.
/            /ar     302  Language=ar
/            /en     302

# ── Pre-cutover English URLs ──
# English lived on bare paths until the move to /en. 301 so the old links keep
# working and any accrued signal transfers.
#
# Listed one by one rather than a `/*  /en/:splat` catch-all: a catch-all here
# would also swallow /ar/*, every asset path and the 404 itself, since these
# run before static-file matching.
/about       /en/about       301
/craft       /en/craft       301
/our-work    /en/our-work    301
/careers     /en/careers     301
/contact     /en/contact     301
/privacy     /en/privacy     301
/terms       /en/terms       301
/products    /en/products    301
/products/*  /en/products/:splat  301

# Back-compat: /preview/ was the homepage's old location, pre-Next.
/preview/*   /en     301

